# FOOTBALL DNA 環境変数のサンプル
# Phase 1（ゲスト診断）は環境変数なしで動作します。
# このファイルを .env.local にコピーして値を設定してください。.env.local は Git に含めないでください。

# --- Phase 2 以降（Supabase）で使用予定。Phase 1 では未使用 ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。クライアントに公開しない（NEXT_PUBLIC_ を付けない）
# SUPABASE_SERVICE_ROLE_KEY=

# --- E2E テスト（任意）---
# 既存の Chromium を使う場合のみ指定
# PLAYWRIGHT_CHROMIUM_PATH=
# E2E_PORT=3100
