# FOOTBALL DNA 環境変数のサンプル
# Phase 1（ゲスト診断）は環境変数なしで動作します。
# このファイルを .env.local にコピーして値を設定してください。.env.local は Git に含めないでください。

# --- Phase 2: Supabase（未設定ならアカウント機能は非表示で、ゲスト診断のみ動作）---
# Supabase の Project Settings → API に表示される値
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 共有リンク・ログインメールのリンク先に使うサイトのURL（末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 注意: service role key はこのアプリでは使いません。設定しないでください。

# --- DB テスト（任意、ローカルの PostgreSQL 16 で RLS を検証）---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- E2E テスト（任意）---
# 既存の Chromium を使う場合のみ指定
# PLAYWRIGHT_CHROMIUM_PATH=
# E2E_PORT=3100
